# Supabase (proyecto DEV / PROD)
# Copia este archivo a `.env` o `.env.local` y completa los valores.
# Nunca subas `.env` ni `.env.local` a Git.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here

# Astro solo expone al navegador variables con prefijo PUBLIC_.
# Deben ser los mismos valores (clave publishable/anon, nunca service_role).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Subdominio del dashboard administrativo (opcional hasta asignar dominios)
# Ejemplo cuando tengas dominio: ADMIN_SUBDOMAIN_HOST=admin.parroquiasancharbel.org
# En local puedes probar con http://admin.localhost:4321 o con http://localhost:4321/admin
ADMIN_SUBDOMAIN_HOST=
PUBLIC_ADMIN_SUBDOMAIN_URL=
PUBLIC_SITE_URL=
# Si se pone en "true", bloquea /admin en el dominio principal y exige entrar por el subdominio
PUBLIC_ADMIN_SUBDOMAIN_ONLY=false

# Reenvío opcional automático a Gmail mediante Webhook de Google Apps Script o Resend
GMAIL_WEBHOOK_URL=
RESEND_API_KEY=

# Google Calendar (opcional; la agenda también lee eventos creados en el dashboard)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_SOURCE=api

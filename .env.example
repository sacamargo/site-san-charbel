# Supabase project URL for the DEV environment.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key. Never put a service_role or secret key here.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# --- Agenda: Google Calendar en solo lectura --------------------------------
# Guía paso a paso: docs/CONECTAR-GOOGLE-CALENDAR.md

# ID del calendario dedicado de la parroquia. Debe estar marcado como público
# con el permiso "Ver todos los detalles del evento".
GOOGLE_CALENDAR_ID=

# Clave de API de Google con la Calendar API habilitada.
# SIN el prefijo PUBLIC_: es de servidor y nunca debe llegar al navegador.
GOOGLE_CALENDAR_API_KEY=

# Fuente de la agenda: "api" (render propio, por defecto) o "embed" (iframe de
# Google). El iframe es el respaldo acordado; no cumple el presupuesto de §8.4
# ni garantiza contraste AA, así que solo se usa si el equipo lo decide.
AGENDA_SOURCE=api

# Segundos que la respuesta de Google se considera fresca antes de revalidar.
AGENDA_CACHE_TTL_SECONDS=600

# Segundos adicionales durante los cuales se sigue sirviendo la copia vieja
# mientras se revalida en segundo plano, o si Google no responde.
AGENDA_CACHE_STALE_SECONDS=86400

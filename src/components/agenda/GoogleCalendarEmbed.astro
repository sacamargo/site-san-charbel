---
/**
 * RESPALDO. Solo se usa si `AGENDA_SOURCE=embed`.
 *
 * Es el iframe oficial de Google. Sirve para salir del paso si el render propio
 * falla o si el equipo decide cambiar, pero conviene saber lo que cuesta:
 *
 *  - carga varios cientos de KB de JavaScript de terceros, contra el
 *    presupuesto de §8.4;
 *  - no respeta ni un token de la paleta ni la tipografía del sitio;
 *  - no podemos garantizar contraste AA ni foco visible dentro del marco;
 *  - no formatea en es-CO ni permite estados vacíos, flyers ni caché.
 *
 * Por eso el render propio es la fuente por defecto y esto es el plan B.
 */
import Icon from '@/components/ui/Icon.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';

interface Props {
  calendarId: string;
  headingId: string;
}

const { calendarId, headingId } = Astro.props;

const params = new URLSearchParams({
  src: calendarId,
  ctz: 'America/Bogota',
  mode: 'MONTH',
  wkst: '1', // 1 = domingo, igual que el render propio
  hl: 'es',
  showTitle: '0',
  showPrint: '0',
  showTabs: '0',
  showCalendars: '0',
  showTz: '0',
});

const embedSrc = `https://calendar.google.com/calendar/embed?${params.toString()}`;
const publicUrl = `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calendarId)}&ctz=America%2FBogota`;
---

<section aria-labelledby={headingId}>
  <SectionTitle id={headingId}>Calendario de la parroquia</SectionTitle>

  <div class="overflow-hidden rounded-band border border-line bg-surface shadow-card">
    <iframe
      src={embedSrc}
      title="Calendario de actividades de la Parroquia San Chárbel"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="block h-[600px] w-full border-0"></iframe>
  </div>

  {/*
    Escape accesible: dentro del iframe no controlamos el foco ni el contraste,
    así que siempre hay una salida a la versión propia de Google.
  */}
  <p class="mt-4">
    <a
      href={publicUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-2 text-small font-bold text-gold-600 hover:text-olive-700"
    >
      <span>Abrir el calendario en Google</span>
      <Icon name="external-link" size={15} />
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </p>
</section>

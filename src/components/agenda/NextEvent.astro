---
/**
 * La celebración más próxima, destacada.
 *
 * El principio del sitio es que el dato útil va primero: quien entra a la
 * agenda casi siempre quiere saber una sola cosa —qué es lo siguiente—, y
 * merece verlo sin recorrer una lista.
 */
import DateBadge from '@/components/ui/DateBadge.astro';
import Icon from '@/components/ui/Icon.astro';
import Watermark from '@/components/ui/Watermark.astro';
import { claveDia, formatCuando, formatFranja } from '@/lib/agenda/format';
import { eventAnchorId } from '@/lib/agenda/ids';
import type { ParishEvent } from '@/lib/types';

interface Props {
  event: ParishEvent;
  headingId: string;
}

const { event, headingId } = Astro.props;
const cruzaDias = claveDia(event.start) !== claveDia(event.end);
const cuando = event.allDay || cruzaDias ? formatCuando(event) : formatFranja(event);
---

<section
  class="relative isolate overflow-hidden rounded-band border border-sand bg-sand-soft"
  aria-labelledby={headingId}
>
  {
    event.flyerUrl && (
      <div class="aspect-2/1 w-full overflow-hidden border-b border-sand bg-surface-alt">
        <img
          src={event.flyerUrl}
          alt={`Pieza gráfica del evento: ${event.title}`}
          width="900"
          height="450"
          loading="eager"
          decoding="async"
          referrerpolicy="no-referrer"
          class="size-full object-cover"
        />
      </div>
    )
  }

  <Watermark
    class="top-1/2 right-[-1rem] -z-10 hidden w-28 -translate-y-1/2 rotate-[125deg] text-olive-700 opacity-[0.07] sm:block"
  />

  <div class="flex flex-col gap-6 p-6 sm:flex-row sm:items-start md:p-8">
    <DateBadge date={event.start} allDay={event.allDay} size="lg" class="border-sand bg-surface" />

    <div class="min-w-0 flex-1">
      {/*
        El nivel del encabezado sigue la estructura, no el tamaño: la sección se
        llama "Lo más próximo" y el título del evento cuelga de ella. Para el
        peso visual está la escala tipográfica, no el nivel del encabezado.
      */}
      <h2
        id={headingId}
        class="font-body text-overline font-bold tracking-[0.12em] text-gold-600 uppercase"
      >
        Lo más próximo
      </h2>

      <h3 class="mt-2 font-display text-h2 font-bold text-ink">{event.title}</h3>

      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-small text-ink-soft" role="list">
        <li class="flex items-center gap-2">
          <Icon name="clock" size={16} class="text-gold-600" />
          <span class="font-semibold">{cuando}</span>
        </li>
        {
          event.location && (
            <li class="flex items-center gap-2">
              <Icon name="map-pin" size={16} class="text-gold-600" />
              <span>{event.location}</span>
            </li>
          )
        }
      </ul>

      {
        event.description && (
          <p class="mt-4 line-clamp-3 max-w-[60ch] text-body whitespace-pre-line text-ink-soft">
            {event.description}
          </p>
        )
      }

      <p class="mt-6">
        <a
          href={`#${eventAnchorId(event.id)}`}
          class="inline-flex min-h-11 items-center gap-2 rounded-pill bg-olive-700 px-6 text-small font-bold text-on-dark transition-colors hover:bg-olive-600"
        >
          <span>Ver el detalle</span>
          <Icon name="chevron-right" size={16} />
        </a>
      </p>
    </div>
  </div>
</section>

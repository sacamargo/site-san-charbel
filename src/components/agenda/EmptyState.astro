---
import Icon from '@/components/ui/Icon.astro';
import Watermark from '@/components/ui/Watermark.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* surface-alt es el fondo que el sistema reserva para el estado vacío. */}
<div
  class:list={[
    'relative isolate overflow-hidden rounded-band border border-line bg-surface-alt px-6 py-12 text-center md:px-10',
    className,
  ]}
>
  <Watermark
    class="top-1/2 right-[-1.5rem] -z-10 hidden w-24 -translate-y-1/2 text-olive-700 opacity-[0.06] sm:block"
  />

  <span
    class="mx-auto flex size-16 items-center justify-center rounded-pill border border-sand bg-surface text-gold-600"
  >
    <Icon name="calendar-days" size={28} />
  </span>

  <p class="mt-6 font-display text-h3 font-bold text-ink">
    <slot name="title">Sin actividades</slot>
  </p>

  <p class="mx-auto mt-3 max-w-[52ch] text-body text-ink-soft">
    <slot />
  </p>
</div>

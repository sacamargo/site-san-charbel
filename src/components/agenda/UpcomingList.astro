---
import AgendaCard from '@/components/cards/AgendaCard.astro';
import EmptyState from '@/components/agenda/EmptyState.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { formatEncabezadoDia } from '@/lib/agenda/format';
import { dayAnchorId } from '@/lib/agenda/ids';
import { groupByDay } from '@/lib/queries/agenda';
import type { ParishEvent } from '@/lib/types';

interface Props {
  events: ParishEvent[];
  headingId: string;
}

const { events, headingId } = Astro.props;
const grupos = groupByDay(events);
---

<section aria-labelledby={headingId}>
  <SectionTitle id={headingId}>Próximos eventos</SectionTitle>

  {
    grupos.length === 0 ? (
      <EmptyState>
        <Fragment slot="title">No hay actividades programadas por ahora</Fragment>
        Cuando la parroquia publique la próxima celebración, aparecerá aquí. Mientras tanto, los
        horarios de misas y confesiones siguen disponibles en la página de horarios.
      </EmptyState>
    ) : (
      <div class="space-y-10">
        {/* El id de cada grupo es el destino de las celdas del calendario. */}
        {grupos.map((grupo) => (
          <div id={dayAnchorId(grupo.key)} class="scroll-mt-24">
            <h3 class="flex items-center gap-4">
              <span class="font-display text-h3 font-bold text-olive-700">
                {formatEncabezadoDia(grupo.date)}
              </span>
              <span aria-hidden="true" class="h-px flex-1 bg-line" />
            </h3>

            <div class="mt-4 space-y-4">
              {grupo.events.map((event) => (
                <AgendaCard event={event} headingLevel="h4" />
              ))}
            </div>
          </div>
        ))}
      </div>
    )
  }
</section>

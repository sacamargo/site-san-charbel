---
/**
 * AgendaCard — Sistema de diseño §6.6
 *
 * Imagen 3:2 con `DateBadge` sobre la esquina inferior izquierda; título `h3`
 * a dos líneas con `line-clamp`; metadatos con icono de 14 px (hora, lugar).
 * Toda la tarjeta es enlace.
 *
 * Se llama `AgendaCard` y no `EventCard`: §0.2 fijó "Agenda", no "Eventos".
 */
import ImagePlaceholder from '@/components/blocks/ImagePlaceholder.astro';
import DateBadge from '@/components/ui/DateBadge.astro';
import Chip from '@/components/ui/Chip.astro';
import Icon from '@/components/ui/Icon.astro';
import { formatHora } from '@/lib/format';
import type { Celebracion } from '@/lib/types';

interface Props {
  celebracion: Celebracion;
}

const { celebracion } = Astro.props;
const { slug, titulo, fecha_inicio, hora, lugar, categoria } = celebracion;
---

<article class="agenda-card">
  <div class="agenda-card__media">
    {/* PENDIENTE §12.2.8 — foto real de la celebración. */}
    <ImagePlaceholder ratio="3/2" label={titulo} rounded="none" tone="light" />
    <DateBadge fecha={fecha_inicio} class="agenda-card__date" />
  </div>

  <div class="agenda-card__body">
    {categoria && <Chip>{categoria}</Chip>}

    <h3 class="agenda-card__title t-h3">
      {/* El enlace envuelve solo el título, pero ::after lo estira a toda la
          tarjeta: así el lector de pantalla anuncia un enlace con nombre útil
          y no "enlace, imagen, 12, MAY, …". */}
      <a href={`/agenda/${slug}`} class="agenda-card__link">{titulo}</a>
    </h3>

    <ul class="agenda-card__meta" role="list">
      {
        hora && (
          <li>
            <Icon name="clock" size={14} />
            <span>{formatHora(hora)}</span>
          </li>
        )
      }
      {
        lugar && (
          <li>
            <Icon name="map-pin" size={14} />
            <span>{lugar}</span>
          </li>
        )
      }
    </ul>
  </div>
</article>

<style>
  .agenda-card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;

    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;

    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .agenda-card:hover {
    border-color: var(--gold-300);
    box-shadow: var(--shadow-md);
  }

  .agenda-card__media {
    position: relative;
  }

  /* §6.6 — la insignia va sobre la esquina inferior izquierda de la imagen. */
  .agenda-card__date {
    position: absolute;
    inset-block-end: calc(var(--space-16) * -1);
    inset-inline-start: var(--space-16);
    z-index: 1;
  }

  .agenda-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    padding: var(--space-card-pad);
    /* Deja aire para la insignia que sobresale de la imagen. */
    padding-block-start: var(--space-32);
  }

  .agenda-card__title {
    margin: 0;
  }

  .agenda-card__link {
    color: var(--text-900);
    text-decoration: none;

    /* Dos líneas como máximo (§6.6). */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Estira el área pulsable a toda la tarjeta sin anidar enlaces.
     z-index: 2 no es decorativo: la imagen y el DateBadge llevan z-index 1, y
     sin esto la mitad superior de la tarjeta —justo la más grande y la más
     fácil de tocar— no navegaba. §6.6 dice que TODA la tarjeta es enlace. */
  .agenda-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .agenda-card__link:hover {
    color: var(--color-accent-text);
  }

  .agenda-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    font-size: var(--step-body-s);
    color: var(--text-500);
  }

  .agenda-card__meta li {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
</style>

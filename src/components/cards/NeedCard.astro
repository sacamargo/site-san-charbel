---
/**
 * NeedCard — Sistema de diseño §6.6
 *
 * Tarjeta del bloque "¿Qué necesitas?": icono circular de 56 px, título `h4`
 * **en primera persona** ("Bautizar a mi hijo") y enlace directo al sacramento.
 * Cuatro por fila.
 *
 * La primera persona no es un capricho de redacción: el bloque existe para que
 * alguien reconozca su necesidad tal como la formularía en voz alta, no en el
 * vocabulario litúrgico de la parroquia.
 *
 * Toda la tarjeta es el enlace.
 */
import IconCircle from '@/components/ui/IconCircle.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

interface Props {
  titulo: string;
  href: string;
  icono: IconName;
  descripcion?: string;
}

const { titulo, href, icono, descripcion } = Astro.props;
---

<a class="need-card" href={href}>
  <IconCircle name={icono} size={56} />
  <span class="need-card__title t-h4">{titulo}</span>
  {descripcion && <span class="need-card__desc t-body-s">{descripcion}</span>}
  <span class="need-card__more t-body-s">
    Ver cómo <Icon name="arrow-right" size={16} />
  </span>
</a>

<style>
  .need-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);

    padding: var(--space-card-pad);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);

    color: inherit;
    text-decoration: none;
    block-size: 100%;

    transition:
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
  }

  .need-card:hover {
    border-color: var(--gold-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .need-card__title {
    color: var(--text-900);
  }

  .need-card__desc {
    color: var(--text-500);
  }

  /* Empuja el "Ver cómo" al pie de la tarjeta para que todas se alineen. */
  .need-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: auto;
    padding-block-start: var(--space-8);
    color: var(--color-accent-text);
    font-weight: var(--fw-semibold);
  }

  .need-card:hover .need-card__more {
    text-decoration: underline;
  }
</style>

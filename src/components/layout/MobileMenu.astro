---
/**
 * MobileMenu — Sistema de diseño §6.1, §10
 *
 * Panel a pantalla completa con foco atrapado y cierre con Esc.
 *
 * Se apoya en <dialog> + showModal(), no en un div con JS: el elemento nativo
 * ya trae atrapado de foco, cierre con Esc, backdrop y bloqueo del scroll de
 * fondo. Son ~15 líneas de script en vez de ~80 de trampa de foco a mano, y el
 * comportamiento lo mantiene el navegador.
 *
 * Los submenús son <details>/<summary>: acordeón sin una sola línea de JS,
 * como pide §6.1 ("acordeón en móvil").
 */
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { navegacion } from '@/data/navigation';

const rutaActual = Astro.url.pathname;

function esActivo(href: string): boolean {
  return href === '/' ? rutaActual === '/' : rutaActual.startsWith(href);
}
---

<button type="button" class="menu-toggle" data-menu-open aria-controls="menu-movil">
  <Icon name="menu" size={24} label="Abrir menú" />
</button>

<dialog id="menu-movil" class="menu" aria-label="Menú principal">
  <div class="menu__bar">
    <span class="menu__title t-overline">Menú</span>
    <button type="button" class="menu-toggle" data-menu-close>
      <Icon name="x" size={24} label="Cerrar menú" />
    </button>
  </div>

  <nav class="menu__nav">
    <ul class="menu__list" role="list">
      {
        navegacion.map((item) =>
          item.children ? (
            <li>
              <details class="menu__group">
                <summary class="menu__summary">
                  <span>{item.label}</span>
                  <Icon name="chevron-down" size={20} class="menu__chevron" />
                </summary>
                <ul class="menu__sublist" role="list">
                  {/* §6.1 — el padre siempre es un enlace navegable, no solo
                      un disparador. En móvil <summary> no puede serlo, así que
                      el padre se repite como primer hijo del acordeón. */}
                  <li>
                    <a
                      href={item.href}
                      class="menu__sublink is-parent"
                      aria-current={esActivo(item.href) ? 'page' : undefined}
                    >
                      Ver {item.label}
                    </a>
                  </li>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="menu__sublink"
                        aria-current={esActivo(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class="menu__link"
                aria-current={esActivo(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>

    <div class="menu__cta">
      <Button variant="primary" size="lg" href="/donar" icon="heart">Donar</Button>
    </div>
  </nav>
</dialog>

<script>
  const dialogo = document.getElementById('menu-movil') as HTMLDialogElement | null;
  if (dialogo) {
    document
      .querySelector('[data-menu-open]')
      ?.addEventListener('click', () => dialogo.showModal());

    dialogo
      .querySelector('[data-menu-close]')
      ?.addEventListener('click', () => dialogo.close());

    // Cerrar al pulsar el backdrop: los clics en él tienen como target el
    // propio <dialog>, no su contenido.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });

    // Al navegar a un enlace del panel, cerrarlo (importa con anclas).
    dialogo.addEventListener('click', (evento) => {
      if ((evento.target as HTMLElement).closest('a')) dialogo.close();
    });
  }
</script>

<style>
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-full);
    color: inherit;
    cursor: pointer;
  }

  /* Solo existe bajo md: en escritorio manda la navegación horizontal. */
  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }

  /* --- Panel ------------------------------------------------------------ */

  .menu {
    /* Reset de los estilos de agente de usuario de <dialog>. */
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100%;
    max-block-size: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-surface-dark);
    color: var(--text-on-dark);
  }

  .menu::backdrop {
    background-color: rgba(42, 30, 23, 0.6);
  }

  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: var(--header-h);
    padding-inline: var(--gutter);
    border-block-end: 1px solid rgba(255, 255, 255, 0.12);
  }

  .menu__title {
    color: var(--text-on-dark-muted);
  }

  .menu__nav {
    padding: var(--space-24) var(--gutter) var(--space-40);
  }

  .menu__list {
    margin: 0;
    padding: 0;
  }

  .menu__link,
  .menu__summary,
  .menu__sublink {
    display: flex;
    align-items: center;
    min-block-size: 44px; /* blanco táctil §10 */
    color: var(--text-on-dark);
    text-decoration: none;
  }

  .menu__link,
  .menu__summary {
    justify-content: space-between;
    padding-block: var(--space-12);
    font-size: var(--step-h4);
    font-weight: var(--fw-semibold);
    border-block-end: 1px solid rgba(255, 255, 255, 0.1);
  }

  .menu__summary {
    cursor: pointer;
    list-style: none;
  }

  .menu__summary::-webkit-details-marker {
    display: none;
  }

  .menu__group[open] .menu__chevron {
    transform: rotate(180deg);
  }

  .menu__chevron {
    transition: transform 150ms ease;
    color: var(--color-accent);
  }

  .menu__sublist {
    margin: 0;
    padding: var(--space-8) 0 var(--space-12) var(--space-16);
  }

  .menu__sublink {
    padding-block: var(--space-8);
    font-size: var(--step-body-s);
    color: var(--text-on-dark-muted);
  }

  .menu__sublink.is-parent {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
  }

  .menu__link[aria-current='page'],
  .menu__sublink[aria-current='page'] {
    color: var(--color-accent);
  }

  .menu__cta {
    margin-block-start: var(--space-32);
  }

  .menu__cta :global(.btn) {
    inline-size: 100%;
  }
</style>

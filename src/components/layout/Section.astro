---
/**
 * Section — Sistema de diseño §3.1, §4.3
 *
 * Bloque vertical de página con el espaciado entre secciones ya aplicado.
 * `variant="alt"` produce la banda a sangrado completo con fondo
 * --color-bg-alt, manteniendo el contenido dentro de los 1200px. Así ningún
 * bloque vuelve a derivar la técnica de sangrado por su cuenta.
 */
import Container from './Container.astro';

interface Props {
  as?: 'section' | 'div';
  variant?: 'default' | 'alt';
  id?: string;
  /** id del título que da nombre a la sección (§10). */
  labelledby?: string;
  /** Desactiva el Container interno cuando el bloque gestiona su propio ancho. */
  bare?: boolean;
  class?: string;
}

const {
  as: Tag = 'section',
  variant = 'default',
  id,
  labelledby,
  bare = false,
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  aria-labelledby={labelledby}
  class:list={['section', variant === 'alt' && 'is-alt', className]}
>
  {
    bare ? (
      <slot />
    ) : (
      <Container>
        <slot />
      </Container>
    )
  }
</Tag>

<style>
  .is-alt {
    background-color: var(--color-bg-alt);
  }
</style>

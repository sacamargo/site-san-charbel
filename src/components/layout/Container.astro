---
/**
 * Container — Sistema de diseño §4.1
 * Ancho máximo de 1200px, centrado, con el gutter del breakpoint actual.
 */
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['container', className]} {...rest}>
  <slot />
</Tag>

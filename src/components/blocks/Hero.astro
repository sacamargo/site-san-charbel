---
/**
 * Hero — portada.
 *
 * Foto a sangrado completo, velo oscuro encima, contenido en claro sobre ella.
 *
 * REPARTO DEL TRABAJO — la regla que costó varias vueltas encontrar:
 *   · LA FOTO pone el hueco. Su mitad izquierda es pared despejada; ahí va el
 *     texto. La derecha lleva el presbiterio completo.
 *   · EL VELO pone la legibilidad, no el hueco. Solo oscurece.
 * Si una foto nueva llega YA oscurecida por la izquierda, hay que bajar el
 * velo o esa zona se convierte en un agujero negro. Pasó exactamente eso.
 *
 * VELO, dos ejes distintos:
 *   · Escritorio: horizontal. Denso hasta el 40% (donde acaba el texto, que
 *     usa max-w-md) y se abre hasta el 4% en el borde derecho. Si el bloque de
 *     texto se ensancha, hay que retrasar también ese 40%.
 *   · Móvil: vertical, y MÁS denso que el de escritorio aunque parezca al
 *     revés — ahí el recorte mete el presbiterio iluminado detrás del texto.
 *     Medido: con el mismo velo en ambos, móvil daba 3.45:1 y escritorio 8.04:1.
 * Un degradado horizontal en móvil deja el final de cada línea sin cobertura.
 * También pasó.
 *
 * ANCLAJE DEL RECORTE: `object-[center_20%]`. La foto es 3:2 y el hero mide
 * ~615px, así que se pierde el 36% del alto a 1440px y el 52% a 1920px. Con el
 * recorte centrado el crucifijo queda decapitado. Si cambias la foto,
 * comprueba dónde cae el crucifijo ANTES de tocar nada más.
 *
 * Los porcentajes del velo están calibrados A ESTA FOTO. Mídela antes de
 * tocarlos: no se pueden copiar de una imagen a otra.
 */
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import type { HeroSlide } from '@/lib/queries/banner';
import heroInicio from '@/assets/hero-inicio.png';

interface Props {
  eyebrow: string;
  titulo: string;
  slides?: HeroSlide[];
  class?: string;
}

const { eyebrow, titulo, slides = [], class: className } = Astro.props;
const slidePrincipal = slides[0] ?? null;
const eyebrowFinal = slidePrincipal?.eyebrow || eyebrow;
const tituloFinal = slidePrincipal?.titulo || titulo;
const ctaPrincipalTexto = slidePrincipal?.cta_texto || 'Conoce nuestra comunidad';
const ctaPrincipalHref = slidePrincipal?.enlace || '/san-charbel';
---

<section
  class:list={['relative isolate overflow-hidden bg-olive-900', className]}
  aria-label="Presentación"
>
  {
    slidePrincipal ? (
      <img
        src={slidePrincipal.imagen_url}
        alt=""
        fetchpriority="high"
        data-hero-img
        class="absolute inset-0 -z-10 size-full object-cover object-[center_20%]"
      />
    ) : (
      <Image
        src={heroInicio}
        alt=""
        widths={[640, 960, 1280, 1536]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 size-full object-cover object-[center_20%]"
      />
    )
  }

  {/* Velo. Móvil: vertical. Escritorio: horizontal, denso a la izquierda. */}
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,color-mix(in_srgb,var(--color-olive-900)_80%,transparent)_0%,color-mix(in_srgb,var(--color-olive-900)_70%,transparent)_55%,color-mix(in_srgb,var(--color-olive-900)_54%,transparent)_100%)] md:bg-[linear-gradient(100deg,color-mix(in_srgb,var(--color-olive-900)_74%,transparent)_0%,color-mix(in_srgb,var(--color-olive-900)_66%,transparent)_40%,color-mix(in_srgb,var(--color-olive-900)_20%,transparent)_66%,color-mix(in_srgb,var(--color-olive-900)_4%,transparent)_100%)]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-(--container-page) px-4 py-20 md:px-6 lg:py-32">
    <div class="max-w-md">
      <p data-hero-eyebrow class="text-overline font-semibold tracking-[0.16em] text-gold-100 uppercase">
        {eyebrowFinal}
      </p>

      <h1 data-hero-titulo class="mt-4 font-display text-display font-bold text-on-dark">{tituloFinal}</h1>

      <p data-hero-subtitulo class="mt-5 text-body text-on-dark/90">
        {slidePrincipal?.subtitulo ? slidePrincipal.subtitulo : <slot />}
      </p>

      {/* Separador ornamental con la cruz. Decorativo. */}
      <div class="mt-8 flex items-center gap-3" aria-hidden="true">
        <span class="h-px w-16 bg-gold-300/60"></span>
        <svg viewBox="0 0 24 24" class="size-4 text-gold-300" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 4v16M7 9h10" stroke-linecap="round"></path>
        </svg>
        <span class="h-px w-16 bg-gold-300/60"></span>
      </div>

      <div class="mt-8 flex flex-wrap gap-4 max-[479px]:flex-col max-[479px]:items-stretch">
        <Button variant="primary-on-dark" href={ctaPrincipalHref} iconEnd="arrow-right">
          {ctaPrincipalTexto}
        </Button>
        <Button variant="outline-light" href="/agenda" icon="clock">Ver horarios de misas</Button>
      </div>

      {
        slides.length > 1 && (
          <div class="mt-8 flex flex-wrap items-center gap-2" role="group" aria-label="Banners destacados">
            {slides.map((s, idx) => (
              <button
                type="button"
                data-hero-slide={JSON.stringify({
                  imagen_url: s.imagen_url,
                  eyebrow: s.eyebrow || eyebrow,
                  titulo: s.titulo || titulo,
                  subtitulo: s.subtitulo || '',
                })}
                aria-current={idx === 0 ? 'true' : 'false'}
                class="inline-flex min-h-11 items-center gap-2 rounded-pill border border-on-dark/40 bg-olive-900/60 px-4 text-overline font-semibold text-on-dark transition-colors hover:border-gold-300 aria-[current=true]:border-gold-500 aria-[current=true]:bg-gold-500 aria-[current=true]:text-olive-900"
              >
                <span>{s.titulo || `Banner ${idx + 1}`}</span>
              </button>
            ))}
          </div>
        )
      }
    </div>
  </div>

  {
    slides.length > 1 && (
      <script>
        const buttons = document.querySelectorAll<HTMLButtonElement>('[data-hero-slide]');
        const img = document.querySelector<HTMLImageElement>('[data-hero-img]');
        const eyebrowEl = document.querySelector<HTMLElement>('[data-hero-eyebrow]');
        const tituloEl = document.querySelector<HTMLElement>('[data-hero-titulo]');
        const subtituloEl = document.querySelector<HTMLElement>('[data-hero-subtitulo]');

        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            try {
              const data = JSON.parse(btn.dataset.heroSlide || '{}');
              if (img && data.imagen_url) img.src = data.imagen_url;
              if (eyebrowEl && data.eyebrow) eyebrowEl.textContent = data.eyebrow;
              if (tituloEl && data.titulo) tituloEl.textContent = data.titulo;
              if (subtituloEl && data.subtitulo) subtituloEl.textContent = data.subtitulo;
              buttons.forEach((b) => b.setAttribute('aria-current', b === btn ? 'true' : 'false'));
            } catch {
              // Ignorar JSON inválido
            }
          });
        });
      </script>
    )
  }
</section>

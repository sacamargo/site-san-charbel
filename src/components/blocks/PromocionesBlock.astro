---
/**
 * Espacio promocional para difundir actividades, jornadas, grupos y campañas
 * pastorales de la iglesia (`parish_promotions`, gestionado en `/admin/promociones`).
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Watermark from '@/components/ui/Watermark.astro';
import { getPromociones } from '@/lib/queries/promociones';

const promociones = await getPromociones();
const destacada = promociones.find((p) => p.destacado) ?? promociones[0] ?? null;
const secundarias = promociones.filter((p) => p.id !== destacada?.id);
---

{
  promociones.length > 0 && (
    <section
      id="actividades-parroquiales"
      class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20"
      aria-labelledby="t-promociones"
    >
      <SectionTitle id="t-promociones">Actividades y vida parroquial</SectionTitle>

      {destacada && (
        <article class="relative isolate overflow-hidden rounded-band border border-sand bg-sand-soft shadow-card">
          <Watermark class="-right-12 -bottom-20 w-32 rotate-[125deg] text-olive-700 opacity-10" />

          <div
            class:list={[
              'relative grid items-center gap-8 p-6 md:p-10',
              destacada.imagen_url ? 'lg:grid-cols-[1.2fr_1fr]' : 'lg:grid-cols-[1fr_auto]',
            ]}
          >
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-pill bg-gold-100 px-3.5 py-1 text-overline font-semibold tracking-wider text-gold-600 uppercase">
                <Icon name="flame" size={14} />
                <span>{destacada.etiqueta}</span>
              </span>

              <h3 class="mt-3 font-display text-h2 font-bold text-ink">{destacada.titulo}</h3>
              {destacada.subtitulo && (
                <p class="mt-1 font-display text-h3 italic text-gold-600">{destacada.subtitulo}</p>
              )}

              <p class="mt-3 max-w-prose text-body text-ink-soft">{destacada.descripcion}</p>

              {(destacada.fecha_texto || destacada.lugar) && (
                <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-small text-ink-soft" role="list">
                  {destacada.fecha_texto && (
                    <li class="flex items-center gap-2">
                      <Icon name="calendar-days" size={16} class="text-gold-600" />
                      <span class="font-semibold">{destacada.fecha_texto}</span>
                    </li>
                  )}
                  {destacada.lugar && (
                    <li class="flex items-center gap-2">
                      <Icon name="map-pin" size={16} class="text-gold-600" />
                      <span>{destacada.lugar}</span>
                    </li>
                  )}
                </ul>
              )}

              <div class="mt-6">
                <Button href={destacada.cta_url} iconEnd="arrow-right">
                  {destacada.cta_texto}
                </Button>
              </div>
            </div>

            {destacada.imagen_url && (
              <div class="overflow-hidden rounded-card border border-sand bg-surface">
                <img
                  src={destacada.imagen_url}
                  alt={destacada.titulo}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full object-cover"
                />
              </div>
            )}
          </div>
        </article>
      )}

      {secundarias.length > 0 && (
        <ul class="mt-6 grid gap-5 md:grid-cols-2" role="list">
          {secundarias.map((promo) => (
            <li class="flex">
              <article class="flex flex-1 flex-col overflow-hidden rounded-card border border-line bg-surface shadow-card transition-shadow hover:shadow-lift">
                {promo.imagen_url && (
                  <img
                    src={promo.imagen_url}
                    alt={promo.titulo}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/9] w-full object-cover"
                  />
                )}
                <div class="flex flex-1 flex-col gap-2 p-6">
                  <span class="w-fit rounded-pill bg-gold-100 px-3 py-0.5 text-overline font-semibold text-gold-600 uppercase">
                    {promo.etiqueta}
                  </span>
                  <h3 class="mt-1 font-display text-h3 font-bold text-ink">{promo.titulo}</h3>
                  {promo.subtitulo && (
                    <p class="text-small font-semibold text-gold-600">{promo.subtitulo}</p>
                  )}
                  <p class="text-small text-ink-soft">{promo.descripcion}</p>

                  {(promo.fecha_texto || promo.lugar) && (
                    <p class="mt-2 text-small text-muted">
                      {[promo.fecha_texto, promo.lugar].filter(Boolean).join(' · ')}
                    </p>
                  )}

                  <div class="mt-auto pt-4">
                    <Button variant="link" href={promo.cta_url} iconEnd="arrow-right">
                      {promo.cta_texto}
                    </Button>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

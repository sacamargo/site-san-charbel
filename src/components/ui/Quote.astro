---
/**
 * Quote — Sistema de diseño §6.9
 *
 * Comilla decorativa dorada de 40 px, texto en `body-l`, referencia en
 * `body-s` 700. Para la oración de la portada y para citas destacadas.
 *
 * Marcado: <figure> + <blockquote> + <figcaption>. La comilla es CSS y va
 * aparte del texto para que el lector de pantalla no la lea.
 */
import Watermark from './Watermark.astro';

interface Props {
  /** Referencia de la cita: "Juan 14, 23", "Oración a San Chárbel". */
  referencia?: string;
  /** Marca de agua de cedro y olivo al 6 % (§1.3.4). */
  watermark?: boolean;
  class?: string;
}

const { referencia, watermark = false, class: className } = Astro.props;
---

<figure class:list={['quote', className]}>
  {watermark && <Watermark position="bottom-right" size={180} />}
  <span class="quote__mark" aria-hidden="true">&ldquo;</span>

  <blockquote class="quote__text t-body-l">
    <slot />
  </blockquote>

  {referencia && <figcaption class="quote__ref t-body-s">{referencia}</figcaption>}
</figure>

<style>
  .quote {
    position: relative;
    margin: 0;
    isolation: isolate;
  }

  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
    color: var(--color-accent);
  }

  .quote__text {
    margin: var(--space-8) 0 0;
    max-inline-size: var(--measure);
    color: var(--text-700);
  }

  .quote__ref {
    margin-block-start: var(--space-16);
    font-weight: var(--fw-bold);
    color: var(--text-900);
  }

</style>

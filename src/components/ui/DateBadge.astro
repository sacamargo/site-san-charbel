---
/**
 * DateBadge — Sistema de diseño §6.7
 *
 * Caja blanca de 56×56, --radius-sm, --shadow-sm. Día en serif 700 a 22 px y
 * mes en `overline` --text-500.
 *
 * Se superpone a la esquina inferior izquierda de la imagen en `AgendaCard`.
 * La fecha completa va en un <time> oculto para lectores de pantalla: "12 MAY"
 * suelto no dice el año ni se lee bien en voz alta.
 */
import { formatFechaCorta, formatFecha } from '@/lib/format';

interface Props {
  /** ISO 8601: "2026-05-12". */
  fecha: string;
  class?: string;
}

const { fecha, class: className } = Astro.props;
const { dia, mes } = formatFechaCorta(fecha);
---

<time class:list={['date-badge', className]} datetime={fecha}>
  <span class="date-badge__day" aria-hidden="true">{dia}</span>
  <span class="date-badge__month t-overline" aria-hidden="true">{mes}</span>
  <span class="visually-hidden">{formatFecha(fecha)}</span>
</time>

<style>
  .date-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    inline-size: 56px;
    block-size: 56px;
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .date-badge__day {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 22px;
    line-height: 1.1;
    color: var(--text-900);
  }

  .date-badge__month {
    color: var(--text-500);
  }
</style>

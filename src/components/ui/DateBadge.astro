---
/**
 * DateBadge — Sistema de diseño §6.7
 *
 * Reutiliza `formatFechaCorta` de @/lib/format, que ya existía para esto.
 * La fecha completa va en el `<time>` para el lector de pantalla; el día y el
 * mes recortados son la versión visual: nadie tiene que reconstruir "3 ago".
 */
import { formatFecha, formatFechaCorta } from '@/lib/format';
import { isoAttribute } from '@/lib/agenda/format';

interface Props {
  date: Date;
  allDay?: boolean;
  /** `lg` para la celebración destacada. */
  size?: 'md' | 'lg';
  class?: string;
}

const { date, allDay = false, size = 'md', class: className } = Astro.props;
const { dia, mes } = formatFechaCorta(date);

const caja = size === 'lg' ? 'h-20 w-20' : 'h-16 w-16';
const numero = size === 'lg' ? 'text-[2rem]' : 'text-[1.625rem]';
---

<time
  datetime={isoAttribute(date, allDay)}
  class:list={[
    'inline-flex shrink-0 flex-col items-center justify-center rounded-card border border-sand bg-sand-soft',
    caja,
    className,
  ]}
>
  <span class="sr-only">{formatFecha(date)}</span>
  <span
    aria-hidden="true"
    class:list={['font-display font-bold leading-none tabular-nums text-olive-900', numero]}
  >
    {dia}
  </span>
  <span
    aria-hidden="true"
    class="mt-1.5 text-overline font-bold tracking-[0.12em] text-gold-600 uppercase"
  >
    {mes}
  </span>
</time>

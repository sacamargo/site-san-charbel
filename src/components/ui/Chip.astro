---
/**
 * Chip — Sistema de diseño §6.8
 *
 * Etiqueta de categoría pill, `body-s` 600, padding 4px 12px.
 *
 * **Único componente verde del contenido** (§1.3.1): fondo --green-100, texto
 * --green-700. Fuera de los cuatro usos de §1.3 no se usa verde en el sitio.
 *
 * §10 — el color nunca es el único portador de información: el chip siempre
 * lleva texto, jamás se reduce a un punto de color.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['chip', 't-body-s', className]}>
  <slot />
</span>

<style>
  .chip {
    display: inline-block;
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-full);

    background-color: var(--green-100);
    color: var(--green-700);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    white-space: nowrap;
  }
</style>

---
/**
 * Watermark — rama de olivo decorativa.
 *
 * Guiño al Líbano de San Chárbel. Va siempre a opacidad muy baja: a ese nivel
 * se lee como textura, no como color, que es la única forma en que el verde
 * entra en esta paleta sin competir con el oliva estructural.
 *
 * CONTRATO DEL DIBUJO — si alguien lo reemplaza, esto es lo que no puede
 * romper:
 *   · viewBox 0 0 100 500 (vertical, 1:5), sin width ni height.
 *   · Todo el color con `currentColor`. Ni un hex: el tono lo pone la clase
 *     `text-*` de quien lo usa y la transparencia la clase `opacity-*`.
 *   · Sin opacity propio, sin <style>, sin id ni class internos.
 *
 * El tallo se sale del viewBox por arriba y por abajo, y algunas hojas se
 * salen por los lados: la rama está pensada para verse cortada por el borde.
 *
 * Ojo con el tamaño: la proporción es 1:5, así que `w-32` da 640px de alto.
 * Se dimensiona por el ancho desde quien la usa.
 *
 * Se dibuja vertical. Para otras orientaciones, rota desde quien la usa
 * (la banda de San Chárbel la gira 125°).
 *
 * Siempre `aria-hidden` y nunca debajo de texto: se ancla a un borde y el
 * contenido va por encima.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['pointer-events-none absolute', className]}
  viewBox="0 0 100 500"
  fill="currentColor"
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
>

---
/**
 * BaseLayout — envoltura de todas las páginas del sitio.
 * Sistema de diseño §2.1 (precarga de fuentes), §6.1, §10.
 */
import { Font } from 'astro:assets';
import Header from '@/components/layout/Header.astro';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/utilities.css';

interface Props {
  /** Se antepone al nombre de la parroquia en <title>. */
  title: string;
  description: string;
  /** §6.1 — `transparent` solo cuando la página abre con un hero oscuro. */
  headerVariant?: 'transparent' | 'solid';
}

const { title, description, headerVariant = 'solid' } = Astro.props;

const SITE_NAME = 'Parroquia San Chárbel';
const fullTitle = `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#33241b" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph y canonical quedan pendientes de que se defina `site` en
        astro.config.mjs; sin dominio no se pueden emitir URLs absolutas. */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={SITE_NAME} />

    {/* §2.1 — precarga ÚNICAMENTE los dos cortes del hero: el <h1> es Playfair
        700 (display-l) y el subtítulo es Nunito 400 (body-l). Los demás pesos
        se cargan normalmente con font-display: swap. */}
    <Font cssVariable="--font-playfair" preload={[{ weight: 700, subset: 'latin' }]} />
    <Font cssVariable="--font-nunito" preload={[{ weight: 400, subset: 'latin' }]} />
  </head>

  <body>
    {/* §10 — primer elemento enfocable del documento. */}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <Header variant={headerVariant} />

    <main id="contenido" class:list={[headerVariant === 'transparent' && 'is-under-header']}>
      <slot />
    </main>

    {/* <Footer /> — §6.16, se construye en la fase de bloques 8/10/11. */}

    <style>
      /* Con el encabezado transparente, el hero empieza en el borde superior
         del viewport y el encabezado flota encima. Sin esto el hero arrancaría
         72px más abajo y la InfoBar caería fuera del pliegue, incumpliendo
         §7.1. El hero compensa con su propio padding superior. */
      .is-under-header {
        margin-block-start: calc(var(--header-h) * -1);
      }
    </style>
  </body>
</html>

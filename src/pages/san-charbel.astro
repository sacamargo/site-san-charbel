---
/**
 * /san-charbel — contenido de la página del santo.
 * Header y Footer vienen de BaseLayout; aquí solo el main.
 *
 * Estructura (mockup):
 *   1. Hero / banner
 *   2. Su vida (línea de tiempo)
 *   3. Virtudes
 *   4. Milagros y testimonios
 *   5. Oración
 *   6. Galería
 *   7. CTA intención
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import ImagePlaceholder from '@/components/blocks/ImagePlaceholder.astro';
import Watermark from '@/components/ui/Watermark.astro';
import {
  hitosVida,
  virtudes,
  milagros,
  oracion,
  galeriaLabels,
} from '@/data/san-charbel';

import banner from '@/assets/san-charbel/banner.png';
import bannerAnimado from '@/assets/conoce-a-san-charbel.gif';
import sketch from '@/assets/san-charbel/oracion-san-charbel-sketch.png';
import imgSanaciones from '@/assets/san-charbel/sanaciones-velas.png';
import imgRespuestas from '@/assets/san-charbel/respuestas-rosario.png';
import imgPresencia from '@/assets/san-charbel/presencia-annaya.png';

const milagroImagenes = {
  'sanaciones-velas': imgSanaciones,
  'respuestas-rosario': imgRespuestas,
  'presencia-annaya': imgPresencia,
} as const;
---

<BaseLayout
  title="San Chárbel"
  description="Conoce a San Chárbel Makhlouf: su vida, virtudes, milagros y una oración para pedir su intercesión."
>
  {/* 1 — Hero */}
  <section class="relative isolate overflow-hidden bg-sand-soft" aria-labelledby="t-hero-santo">
    {/*
      El GIF es decorativo: el contenido y el texto alternativo viven en el
      HTML. Para usuarios que reducen movimiento se conserva el banner estático.
    */}
    <img
      src={bannerAnimado.src}
      alt=""
      width={bannerAnimado.width}
      height={bannerAnimado.height}
      aria-hidden="true"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover object-[center_30%] motion-reduce:hidden"
    />
    <Image
      src={banner}
      alt=""
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 hidden size-full object-cover object-[center_30%] motion-reduce:block"
    />
    {/* Velo suave a la izquierda para legibilidad del texto sobre la foto clara. */}
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,color-mix(in_srgb,var(--color-ivory)_88%,transparent)_0%,color-mix(in_srgb,var(--color-ivory)_72%,transparent)_45%,color-mix(in_srgb,var(--color-ivory)_28%,transparent)_100%)] md:bg-[linear-gradient(95deg,color-mix(in_srgb,var(--color-ivory)_92%,transparent)_0%,color-mix(in_srgb,var(--color-ivory)_78%,transparent)_38%,color-mix(in_srgb,var(--color-ivory)_18%,transparent)_62%,transparent_100%)]"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-(--container-page) px-4 py-20 md:px-6 md:py-28 lg:py-32">
      <div class="max-w-lg">
        <p class="font-display text-body italic text-gold-600">Conoce a</p>
        <h1 id="t-hero-santo" class="mt-2 font-display text-display font-bold text-ink">
          San Chárbel Makhlouf
        </h1>
        <p class="mt-5 text-body text-ink-soft">
          Un santo del Líbano, ejemplo de fe, oración y entrega total a Dios. Su vida sigue
          inspirando a millones de personas en el mundo.
        </p>
      </div>
    </div>
  </section>

  {/* 2 — Su vida */}
  <section class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20" aria-labelledby="t-vida">
    <SectionTitle id="t-vida">Su vida</SectionTitle>

    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-4">
      {
        hitosVida.map((hito, i) => (
          <li class="relative text-center">
            {i < hitosVida.length - 1 && (
              <span
                class="pointer-events-none absolute top-6 left-[calc(50%+1.75rem)] hidden h-px w-[calc(100%-1.5rem)] bg-gold-300 lg:block"
                aria-hidden="true"
              />
            )}
            <span class="mx-auto grid size-12 place-items-center rounded-pill border border-gold-300 bg-surface text-gold-600">
              <Icon name={hito.icono} size={22} />
            </span>
            <p class="mt-4 font-display text-h3 font-bold text-ink">{hito.anio}</p>
            <p class="mt-1 text-small font-semibold text-gold-600">{hito.titulo}</p>
            <p class="mt-2 text-small text-ink-soft">{hito.descripcion}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* 3 — Virtudes */}
  <section class="bg-surface-alt" aria-labelledby="t-virtudes">
    <div class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20">
      <SectionTitle id="t-virtudes">Virtudes que lo caracterizaron</SectionTitle>

      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5" role="list">
        {
          virtudes.map((virtud) => (
            <li class="flex">
              <article class="flex flex-1 flex-col items-center gap-3 rounded-card border border-line bg-surface p-6 text-center shadow-card">
                <span class="grid size-12 place-items-center rounded-pill bg-gold-100 text-gold-600">
                  <Icon name={virtud.icono} size={22} />
                </span>
                <h3 class="font-display text-h3 font-bold text-ink">{virtud.nombre}</h3>
                <p class="text-small text-ink-soft">{virtud.descripcion}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 4 — Milagros */}
  <section class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20" aria-labelledby="t-milagros">
    <SectionTitle id="t-milagros">Milagros y testimonios</SectionTitle>

    <ul class="grid gap-6 md:grid-cols-3" role="list">
      {
        milagros.map((item) => (
          <li>
            <article class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
              <Image
                src={milagroImagenes[item.imagen]}
                alt={item.alt}
                widths={[360, 720]}
                sizes="(min-width: 768px) 33vw, 100vw"
                loading="lazy"
                decoding="async"
                class="aspect-[3/4] w-full object-cover"
              />
              <div class="p-5">
                <h3 class="font-display text-h3 font-bold text-ink">{item.titulo}</h3>
                <p class="mt-2 text-small text-ink-soft">{item.descripcion}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 5 — Oración */}
  <section class="relative overflow-hidden bg-sand-soft" aria-labelledby="t-oracion">
    <Watermark class="-left-10 -bottom-16 w-28 -rotate-12 text-olive-700 opacity-10" />
    <div class="relative mx-auto grid max-w-(--container-page) items-center gap-10 px-4 py-14 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.2fr)_minmax(0,0.9fr)] md:px-6 md:py-20">
      <div class="mx-auto w-48 md:w-full md:max-w-xs">
        <Image
          src={sketch}
          alt="Dibujo a carboncillo de San Chárbel Makhlouf"
          widths={[240, 480]}
          sizes="(min-width: 768px) 240px, 192px"
          loading="lazy"
          decoding="async"
          class="w-full object-contain"
        />
      </div>

      <div>
        <h2 id="t-oracion" class="font-display text-h2 font-bold text-ink">{oracion.titulo}</h2>
        <span class="mt-3 block h-0.5 w-14 rounded-pill bg-gold-500" aria-hidden="true"></span>
        <div class="mt-6 space-y-3 text-body text-ink-soft">
          {
            oracion.texto
              .trim()
              .split(/\n\n+/)
              .map((parrafo) => <p class="whitespace-pre-line">{parrafo}</p>)
          }
        </div>
      </div>

      <aside class="rounded-card border border-gold-300 bg-surface p-8 text-center shadow-card">
        <p class="font-display text-display leading-none text-gold-500" aria-hidden="true">“</p>
        <p class="mt-2 font-display text-h2 font-bold text-ink italic">{oracion.cita}</p>
        <p class="mt-4 text-small text-muted">— {oracion.citaAutor}</p>
      </aside>
    </div>
  </section>

  {/* 6 — Galería */}
  <section class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20" aria-labelledby="t-galeria-santo">
    <SectionTitle id="t-galeria-santo">Galería</SectionTitle>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        galeriaLabels.map((label) => (
          <li>
            <ImagePlaceholder ratio="4/3" label={label} />
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex justify-center">
      <Button href="/galeria" variant="outline" iconEnd="arrow-right">Ver más fotos</Button>
    </div>
  </section>

  {/* 7 — CTA */}
  <section class="bg-sand" aria-labelledby="t-intencion">
    <div class="mx-auto flex max-w-(--container-page) flex-col items-center gap-6 px-4 py-10 text-center md:flex-row md:justify-between md:px-6 md:text-left">
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-5">
        <span class="grid size-14 shrink-0 place-items-center rounded-pill bg-surface text-gold-600 shadow-card">
          <Icon name="hand-heart" size={28} />
        </span>
        <div>
          <h2 id="t-intencion" class="font-display text-h2 font-bold text-ink">
            Pide la intercesión de San Chárbel
          </h2>
          <p class="mt-1 text-small text-ink-soft">
            Envía una intención de oración. La comunidad la eleva con fe.
          </p>
        </div>
      </div>
      <Button href="/contacto#intencion" iconEnd="arrow-right">Enviar una intención</Button>
    </div>
  </section>
</BaseLayout>

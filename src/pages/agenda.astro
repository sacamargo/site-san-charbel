---
/**
 * Agenda — vista mensual de solo lectura y lista de próximos eventos.
 *
 * Fuente de verdad: el calendario dedicado de Google de la parroquia.
 * No hay creación, edición ni eliminación de eventos desde aquí, ni tabla de
 * eventos en Supabase (contrato 1 del equipo).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AgendaHero from '@/components/agenda/AgendaHero.astro';
import AgendaNotice from '@/components/agenda/AgendaNotice.astro';
import EmptyState from '@/components/agenda/EmptyState.astro';
import GoogleCalendarEmbed from '@/components/agenda/GoogleCalendarEmbed.astro';
import MonthCalendar from '@/components/agenda/MonthCalendar.astro';
import NextEvent from '@/components/agenda/NextEvent.astro';
import UpcomingList from '@/components/agenda/UpcomingList.astro';
import Icon from '@/components/ui/Icon.astro';
import { buildMonthGrid } from '@/lib/agenda/month-grid';
import { agendaWindow, resolveMonth } from '@/lib/agenda/window';
import { readCalendarId, readSource } from '@/lib/google-calendar/config';
import { getAgenda, groupByDay, upcomingEvents } from '@/lib/queries/agenda';

const now = new Date();
const source = readSource();
const calendarId = readCalendarId();

const ventana = agendaWindow(now);
const mesPedido = Astro.url.searchParams.get('mes');
const mes = resolveMonth(mesPedido, ventana, now);

const agenda = await getAgenda(now);
const grid = buildMonthGrid({
  monthKey: mes,
  events: agenda.events,
  now,
  firstMonth: ventana.firstMonth,
  lastMonth: ventana.lastMonth,
});

const proximos = upcomingEvents(agenda.events, now, 12);
// Solo se enlazan los días que realmente tienen grupo abajo: un ancla rota es
// peor que ninguna. Los días pasados y los que quedan fuera del tope de 12
// eventos se muestran marcados, pero sin enlace.
const diasEnlazables = new Set(groupByDay(proximos).map((grupo) => grupo.key));
const proximoEvento = proximos[0] ?? null;

// Deja que un CDN o proxy sirva la página cinco minutos sin volver al servidor.
// La caché interna de la agenda ya evita golpear a Google en cada visita; esto
// evita golpear al servidor en cada visita.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300');

const suscribirseUrl = calendarId
  ? `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(calendarId)}`
  : null;
---

<BaseLayout
  title="Agenda"
  description="Celebraciones y actividades de la Parroquia San Chárbel de Villa Carolina, Barranquilla."
>
  <AgendaHero status={agenda.status} fetchedAt={agenda.fetchedAt} eventCount={proximos.length} />

  <div class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20">
    {
      agenda.status !== 'ok' && (
        <div class="mb-10">
          <AgendaNotice status={agenda.status} fetchedAt={agenda.fetchedAt} />
        </div>
      )
    }

    {proximoEvento && <NextEvent event={proximoEvento} headingId="titulo-proximo" />}

    {/* Dos paneles en escritorio; en móvil se apila, calendario primero.
        Se evaluó dejar el calendario fijo al hacer scroll y se descartó: mide
        unos 915px de alto, así que en una pantalla de 900px la última semana
        quedaría permanentemente fuera de la vista. */}
    <div class:list={['grid gap-12 lg:grid-cols-12 lg:gap-10', proximoEvento && 'mt-14 md:mt-16']}>
      <div class="lg:col-span-7">
        {
          source === 'embed' && calendarId ? (
            <GoogleCalendarEmbed calendarId={calendarId} headingId="titulo-calendario" />
          ) : grid ? (
            <MonthCalendar grid={grid} linkableDays={diasEnlazables} headingId="titulo-calendario" />
          ) : (
            <EmptyState>
              <Fragment slot="title">No pudimos mostrar el calendario</Fragment>
              Vuelve a la agenda del mes actual para ver las próximas celebraciones.
            </EmptyState>
          )
        }

        {
          suscribirseUrl && (
            <p class="mt-6">
              <a
                href={suscribirseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-2 rounded-pill border border-sand bg-surface px-6 text-small font-bold text-gold-600 transition-colors hover:border-olive-700 hover:bg-sand-soft hover:text-olive-700"
              >
                <Icon name="calendar-days" size={17} />
                <span>Añadir a mi Google Calendar</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </p>
          )
        }
      </div>

      <div class="lg:col-span-5">
        <UpcomingList events={proximos} headingId="titulo-proximos" />
      </div>
    </div>
  </div>
</BaseLayout>

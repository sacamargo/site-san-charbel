---
/**
 * /admin/horarios — Gestión de horarios de misas, confesiones, adoración y
 * despacho parroquial (`mass_schedules`).
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '@/lib/supabase/server';

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

let notice: string | null = null;
let errorMsg: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'create') {
    const tipo = String(form.get('tipo') ?? 'misa');
    const dia = String(form.get('dia') ?? '').trim();
    const horasRaw = String(form.get('horas') ?? '');
    const horas = horasRaw
      .split(',')
      .map((h) => h.trim())
      .filter(Boolean);
    const nota = String(form.get('nota') ?? '').trim() || null;
    const orden = Number(form.get('orden') ?? 1) || 1;

    if (!dia || !horas.length) {
      errorMsg = 'El día y al menos una hora son obligatorios.';
    } else {
      const { error } = await supabase.from('mass_schedules').insert({
        tipo,
        dia,
        dias: [],
        horas,
        nota,
        orden,
        activo: true,
      });
      if (error) errorMsg = error.message;
      else notice = 'Horario creado.';
    }
  }

  if (intent === 'toggle') {
    const id = String(form.get('id') ?? '');
    const activo = form.get('activo') === 'true';
    const { error } = await supabase
      .from('mass_schedules')
      .update({ activo: !activo })
      .eq('id', id);
    if (error) errorMsg = error.message;
    else notice = 'Estado actualizado.';
  }

  if (intent === 'delete') {
    const id = String(form.get('id') ?? '');
    const { error } = await supabase.from('mass_schedules').delete().eq('id', id);
    if (error) errorMsg = error.message;
    else notice = 'Horario eliminado.';
  }
}

const { data: rows, error: listError } = await supabase
  .from('mass_schedules')
  .select('*')
  .order('orden', { ascending: true });

if (listError && !errorMsg) {
  errorMsg = listError.message.includes('Could not find')
    ? 'Falta aplicar la migración SQL en Supabase.'
    : listError.message;
}

const email = Astro.locals.adminUser?.email ?? null;
---

<AdminLayout
  title="Horarios de misas y atención"
  subtitle="Administra los horarios que se muestran en la portada y en la página de servicios."
  email={email}
>
  {
    notice && (
      <p class="mb-6 rounded-card border border-olive-700/30 bg-sand-soft px-4 py-3 text-small font-semibold text-ink" role="status">
        {notice}
      </p>
    )
  }
  {
    errorMsg && (
      <p class="mb-6 rounded-card border border-gold-300 bg-gold-100 px-4 py-3 text-small font-semibold text-gold-600" role="alert">
        {errorMsg}
      </p>
    )
  }

  <section class="rounded-card border border-line bg-surface p-6 shadow-card">
    <h2 class="font-display text-h3 font-bold text-ink">Agregar nuevo horario</h2>
    <form method="POST" class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="intent" value="create" />

      <label class="block">
        <span class="text-small font-semibold text-ink">Tipo</span>
        <select
          name="tipo"
          class="mt-1 min-h-11 w-full rounded-card border border-line bg-ivory px-3.5 py-2"
        >
          <option value="misa">Misa</option>
          <option value="confesion">Confesión</option>
          <option value="despacho">Despacho parroquial</option>
          <option value="adoracion">Adoración eucarística</option>
          <option value="rosario">Santo Rosario</option>
        </select>
      </label>

      <label class="block">
        <span class="text-small font-semibold text-ink">Día o rango de días *</span>
        <input
          name="dia"
          required
          placeholder="Ej. Lunes a viernes / Domingos"
          class="mt-1 min-h-11 w-full rounded-card border border-line bg-ivory px-3.5 py-2"
        />
      </label>

      <label class="block">
        <span class="text-small font-semibold text-ink">
          Horas en formato 24h (separadas por coma) *
        </span>
        <input
          name="horas"
          required
          placeholder="07:00, 09:00, 11:00, 18:00"
          class="mt-1 min-h-11 w-full rounded-card border border-line bg-ivory px-3.5 py-2"
        />
      </label>

      <label class="block">
        <span class="text-small font-semibold text-ink">Orden de aparición</span>
        <input
          type="number"
          name="orden"
          value="1"
          min="1"
          class="mt-1 min-h-11 w-full rounded-card border border-line bg-ivory px-3.5 py-2"
        />
      </label>

      <label class="block sm:col-span-2">
        <span class="text-small font-semibold text-ink">Nota aclaratoria (opcional)</span>
        <input
          name="nota"
          placeholder="Ej. Media hora antes de cada misa"
          class="mt-1 min-h-11 w-full rounded-card border border-line bg-ivory px-3.5 py-2"
        />
      </label>

      <div class="sm:col-span-2">
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-pill bg-olive-700 px-6 py-3 text-small font-semibold text-on-dark hover:bg-olive-600"
        >
          Guardar horario
        </button>
      </div>
    </form>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-h3 font-bold text-ink">Horarios registrados ({rows?.length ?? 0})</h2>
    {
      !rows?.length ? (
        <p class="mt-4 text-small text-ink-soft">
          Aún no hay horarios en Supabase; la portada muestra los horarios por defecto del
          repositorio.
        </p>
      ) : (
        <ul class="mt-4 divide-y divide-line rounded-card border border-line bg-surface" role="list">
          {rows.map((row) => (
            <li class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-display text-h3 font-bold capitalize text-ink">
                  {row.tipo} · {row.dia}
                </p>
                <p class="text-small text-ink-soft">
                  {(row.horas ?? []).join(' · ')}
                  {row.nota ? ` — ${row.nota}` : ''}
                  {' · '}
                  {row.activo ? 'Activo' : 'Oculto'}
                </p>
              </div>
              <div class="flex gap-2">
                <form method="POST">
                  <input type="hidden" name="intent" value="toggle" />
                  <input type="hidden" name="id" value={row.id} />
                  <input type="hidden" name="activo" value={String(row.activo)} />
                  <button
                    type="submit"
                    class="inline-flex min-h-11 items-center rounded-pill border border-olive-700 px-4 text-small font-semibold text-olive-700"
                  >
                    {row.activo ? 'Desactivar' : 'Activar'}
                  </button>
                </form>
                <form method="POST" onsubmit="return confirm('¿Eliminar este horario?');">
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="id" value={row.id} />
                  <button
                    type="submit"
                    class="inline-flex min-h-11 items-center rounded-pill border border-line px-4 text-small font-semibold text-ink-soft"
                  >
                    Eliminar
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</AdminLayout>

---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '@/lib/supabase/server';
import { parseGoogleFormEmbed } from '@/lib/admin/google-form';

const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies });
let notice: string | null = null;
let errorMsg: string | null = null;

function slugify(text: string) {
	return text
		.toLowerCase()
		.normalize('NFD')
		.replace(/\p{M}/gu, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
}

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const intent = String(form.get('intent') ?? '');

	if (intent === 'create') {
		const nombre = String(form.get('nombre') ?? '').trim();
		const descripcion_corta = String(form.get('descripcion_corta') ?? '').trim();
		const descripcion_modal = String(form.get('descripcion_modal') ?? '').trim();
		const icono = String(form.get('icono') ?? 'cross').trim() || 'cross';
		const embedRaw = String(form.get('form_embed') ?? '');
		const form_embed_url = parseGoogleFormEmbed(embedRaw);

		if (embedRaw.trim() && !form_embed_url) {
			errorMsg = 'El HTML/URL del formulario no es un Google Form válido.';
		} else if (!nombre) {
			errorMsg = 'El nombre es obligatorio.';
		} else {
			const { error } = await supabase.from('parish_services').insert({
				nombre,
				slug: slugify(nombre),
				descripcion_corta,
				descripcion_modal,
				icono,
				form_embed_url,
				activo: true,
			});
			if (error) errorMsg = error.message;
			else notice = 'Servicio creado.';
		}
	}

	if (intent === 'toggle') {
		const id = String(form.get('id') ?? '');
		const activo = form.get('activo') === 'true';
		const { error } = await supabase.from('parish_services').update({ activo: !activo }).eq('id', id);
		if (error) errorMsg = error.message;
		else notice = 'Estado actualizado.';
	}

	if (intent === 'save_form') {
		const id = String(form.get('id') ?? '');
		const embedRaw = String(form.get('form_embed') ?? '');
		const form_embed_url = parseGoogleFormEmbed(embedRaw);
		if (embedRaw.trim() && !form_embed_url) {
			errorMsg = 'El HTML/URL del formulario no es un Google Form válido.';
		} else {
			const { error } = await supabase
				.from('parish_services')
				.update({ form_embed_url })
				.eq('id', id);
			if (error) errorMsg = error.message;
			else notice = 'Formulario guardado.';
		}
	}

	if (intent === 'delete') {
		const id = String(form.get('id') ?? '');
		const { error } = await supabase.from('parish_services').delete().eq('id', id);
		if (error) errorMsg = error.message;
		else notice = 'Servicio eliminado.';
	}
}

const { data: services, error: listError } = await supabase
	.from('parish_services')
	.select('*')
	.order('orden', { ascending: true });

if (listError && !errorMsg) {
	errorMsg = listError.message.includes('Could not find')
		? 'Falta aplicar la migración SQL (docs/ADMIN-SETUP.md).'
		: listError.message;
}

const email = Astro.locals.adminUser?.email ?? null;
---

<AdminLayout title="Servicios" email={email}>
	<h1 class="font-display text-h2 font-bold">Servicios</h1>
	<p class="mt-1 text-small text-ink-soft">
		Lista abierta: puedes agregar más sacramentos/servicios. Cada uno puede llevar un Google Form embebido.
	</p>

	{notice && <p class="mt-4 rounded-lg bg-sand-soft px-3 py-2 text-small" role="status">{notice}</p>}
	{errorMsg && <p class="mt-4 rounded-lg bg-gold-100 px-3 py-2 text-small text-gold-600" role="alert">{errorMsg}</p>}

	<section class="mt-8 rounded-card border border-line bg-surface p-6 shadow-card">
		<h2 class="font-display text-h3 font-bold">Nuevo servicio</h2>
		<form method="POST" class="mt-4 grid gap-4">
			<input type="hidden" name="intent" value="create" />
			<label class="block">
				<span class="text-small font-semibold">Nombre *</span>
				<input name="nombre" required class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2" />
			</label>
			<label class="block">
				<span class="text-small font-semibold">Descripción corta (tarjeta)</span>
				<input name="descripcion_corta" class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2" />
			</label>
			<label class="block">
				<span class="text-small font-semibold">Texto del modal</span>
				<textarea name="descripcion_modal" rows="3" class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2"></textarea>
			</label>
			<label class="block">
				<span class="text-small font-semibold">Icono (nombre del mapa)</span>
				<input name="icono" value="cross" class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2" />
			</label>
			<label class="block">
				<span class="text-small font-semibold">Google Form (pega el iframe o la URL)</span>
				<textarea name="form_embed" rows="3" placeholder='<iframe src="https://docs.google.com/forms/..." ...' class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2 font-mono text-small"></textarea>
			</label>
			<button type="submit" class="w-fit rounded-pill bg-olive-700 px-6 py-3 text-small font-semibold text-on-dark">Crear</button>
		</form>
	</section>

	<section class="mt-10">
		<h2 class="font-display text-h3 font-bold">Listado</h2>
		{
			!services?.length ? (
				<p class="mt-4 text-small text-ink-soft">Sin servicios. Aplica la semilla SQL o crea el primero aquí.</p>
			) : (
				<ul class="mt-4 space-y-4">
					{services.map((svc) => (
						<li class="rounded-card border border-line bg-surface p-4 shadow-card">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<p class="font-semibold">{svc.nombre}</p>
									<p class="text-small text-ink-soft">
										{svc.activo ? 'Activo' : 'Oculto'}
										{svc.form_embed_url ? ' · Formulario listo' : ' · Sin formulario'}
									</p>
								</div>
								<div class="flex flex-wrap gap-2">
									<form method="POST">
										<input type="hidden" name="intent" value="toggle" />
										<input type="hidden" name="id" value={svc.id} />
										<input type="hidden" name="activo" value={String(svc.activo)} />
										<button type="submit" class="rounded-pill border border-olive-700 px-4 py-2 text-small font-semibold text-olive-700">
											{svc.activo ? 'Desactivar' : 'Activar'}
										</button>
									</form>
									<form method="POST" onsubmit="return confirm('¿Eliminar?');">
										<input type="hidden" name="intent" value="delete" />
										<input type="hidden" name="id" value={svc.id} />
										<button type="submit" class="rounded-pill border border-line px-4 py-2 text-small font-semibold text-ink-soft">
											Eliminar
										</button>
									</form>
								</div>
							</div>
							<form method="POST" class="mt-3">
								<input type="hidden" name="intent" value="save_form" />
								<input type="hidden" name="id" value={svc.id} />
								<label class="block">
									<span class="text-small font-semibold">Actualizar Google Form</span>
									<textarea name="form_embed" rows="2" class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2 font-mono text-small">{svc.form_embed_url ?? ''}</textarea>
								</label>
								<button type="submit" class="mt-2 rounded-pill border border-line px-4 py-2 text-small font-semibold">
									Guardar formulario
								</button>
							</form>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AdminLayout>

---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '@/lib/supabase/server';

const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies });
let notice: string | null = null;
let errorMsg: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const intent = String(form.get('intent') ?? '');

	if (intent === 'create') {
		const titulo = String(form.get('titulo') ?? '').trim() || null;
		const enlace = String(form.get('enlace') ?? '').trim() || null;
		const file = form.get('imagen');
		if (!(file instanceof File) || file.size === 0) {
			errorMsg = 'Elige una imagen.';
		} else {
			const ext = file.name.split('.').pop() || 'jpg';
			const path = `${Date.now()}-${crypto.randomUUID()}.${ext}`;
			const buffer = new Uint8Array(await file.arrayBuffer());
			const { error: upErr } = await supabase.storage.from('hero-banners').upload(path, buffer, {
				contentType: file.type || 'image/jpeg',
				upsert: false,
			});
			if (upErr) {
				errorMsg = upErr.message;
			} else {
				const { data: pub } = supabase.storage.from('hero-banners').getPublicUrl(path);
				const { error } = await supabase.from('hero_slides').insert({
					imagen_url: pub.publicUrl,
					titulo,
					enlace,
					activo: true,
				});
				if (error) errorMsg = error.message;
				else notice = 'Slide añadido.';
			}
		}
	}

	if (intent === 'toggle') {
		const id = String(form.get('id') ?? '');
		const activo = form.get('activo') === 'true';
		const { error } = await supabase.from('hero_slides').update({ activo: !activo }).eq('id', id);
		if (error) errorMsg = error.message;
		else notice = 'Estado actualizado.';
	}

	if (intent === 'delete') {
		const id = String(form.get('id') ?? '');
		const { error } = await supabase.from('hero_slides').delete().eq('id', id);
		if (error) errorMsg = error.message;
		else notice = 'Slide eliminado.';
	}
}

const { data: slides, error: listError } = await supabase
	.from('hero_slides')
	.select('*')
	.order('orden', { ascending: true });

if (listError && !errorMsg) {
	errorMsg = listError.message.includes('Could not find')
		? 'Falta aplicar la migración SQL (docs/ADMIN-SETUP.md).'
		: listError.message;
}

const email = Astro.locals.adminUser?.email ?? null;
---

<AdminLayout title="Banner" email={email}>
	<h1 class="font-display text-h2 font-bold">Banner / publicidad</h1>
	<p class="mt-1 text-small text-ink-soft">Slides del carrusel principal (imagen 16:9 recomendada).</p>

	{notice && <p class="mt-4 rounded-lg bg-sand-soft px-3 py-2 text-small" role="status">{notice}</p>}
	{errorMsg && <p class="mt-4 rounded-lg bg-gold-100 px-3 py-2 text-small text-gold-600" role="alert">{errorMsg}</p>}

	<section class="mt-8 rounded-card border border-line bg-surface p-6 shadow-card">
		<h2 class="font-display text-h3 font-bold">Nuevo slide</h2>
		<form method="POST" enctype="multipart/form-data" class="mt-4 grid gap-4">
			<input type="hidden" name="intent" value="create" />
			<label class="block">
				<span class="text-small font-semibold">Imagen</span>
				<input type="file" name="imagen" accept="image/*" required class="mt-1 block w-full text-small" />
			</label>
			<label class="block">
				<span class="text-small font-semibold">Título (opcional)</span>
				<input name="titulo" class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2" />
			</label>
			<label class="block">
				<span class="text-small font-semibold">Enlace (opcional)</span>
				<input name="enlace" type="url" class="mt-1 w-full rounded-lg border border-line bg-ivory px-3 py-2" />
			</label>
			<button type="submit" class="w-fit rounded-pill bg-olive-700 px-6 py-3 text-small font-semibold text-on-dark">Añadir</button>
		</form>
	</section>

	<section class="mt-10">
		<h2 class="font-display text-h3 font-bold">Slides</h2>
		{
			!slides?.length ? (
				<p class="mt-4 text-small text-ink-soft">Sin slides. El hero público sigue usando la imagen del repo hasta que agregues uno.</p>
			) : (
				<ul class="mt-4 space-y-4">
					{slides.map((s) => (
						<li class="overflow-hidden rounded-card border border-line bg-surface shadow-card">
							<img src={s.imagen_url} alt={s.titulo ?? 'Banner'} class="aspect-video w-full object-cover" />
							<div class="flex flex-wrap items-center justify-between gap-2 p-3">
								<p class="text-small">{s.titulo || 'Sin título'} · {s.activo ? 'Activo' : 'Oculto'}</p>
								<div class="flex gap-2">
									<form method="POST">
										<input type="hidden" name="intent" value="toggle" />
										<input type="hidden" name="id" value={s.id} />
										<input type="hidden" name="activo" value={String(s.activo)} />
										<button type="submit" class="text-small font-semibold text-olive-700">{s.activo ? 'Desactivar' : 'Activar'}</button>
									</form>
									<form method="POST" onsubmit="return confirm('¿Eliminar?');">
										<input type="hidden" name="intent" value="delete" />
										<input type="hidden" name="id" value={s.id} />
										<button type="submit" class="text-small font-semibold text-ink-soft">Eliminar</button>
									</form>
								</div>
							</div>
						</li>
					))}
				</ul>
			)
		}
	</section>
</AdminLayout>

---
/**
 * /admin/login — Portal de acceso al Dashboard administrativo.
 *
 * Estándares de seguridad aplicados:
 *  - Verificación de sesión en servidor con `supabase.auth.getUser()` + token HMAC firmado.
 *  - Limitador de intentos por IP (6 intentos / 15 min) contra fuerza bruta.
 *  - Token CSRF sincronizado en cookie HttpOnly + verificación de Origin.
 *  - Sanitización del parámetro `next` contra Open Redirect.
 *  - Mensajes de error unificados que impiden enumeración de cuentas.
 *  - Cabeceras anti-clickjacking y `no-store` aplicadas desde el middleware.
 *  - Sin división por roles: todo usuario autenticado recibe permisos completos.
 */
import { Font } from 'astro:assets';
import AdminBrand from '@/components/admin/AdminBrand.astro';
import Icon from '@/components/ui/Icon.astro';
import {
  createMasterSessionToken,
  getAdminSession,
  MASTER_SESSION_COOKIE,
  matchesMasterCredentials,
} from '@/lib/admin/auth';
import {
  checkLoginRateLimit,
  clearLoginAttempts,
  getClientIp,
  recordFailedLogin,
  sanitizeNextPath,
} from '@/lib/admin/security';
import { createSupabaseServerClient, hasSupabaseConfig } from '@/lib/supabase/server';
import '@/styles/global.css';

const nextPath = sanitizeNextPath(Astro.url.searchParams.get('next'));
const { user, isAdmin } = await getAdminSession(Astro.request, Astro.cookies);

if (user && isAdmin) {
  return Astro.redirect(nextPath, 302);
}

const ip = getClientIp(Astro.request);
let rateLimit = checkLoginRateLimit(ip);
let errorMsg: string | null = Astro.url.searchParams.get('error');
const resetOk = Astro.url.searchParams.get('restablecida') === '1';

if (Astro.request.method === 'POST') {
  rateLimit = checkLoginRateLimit(ip);

  if (!rateLimit.allowed) {
    Astro.response.headers.set('Retry-After', String(rateLimit.retryAfterSeconds));
    errorMsg = 'bloqueado';
  } else {
    const form = await Astro.request.formData();
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    const password = String(form.get('password') ?? '');
    const formNext = sanitizeNextPath(String(form.get('next') ?? nextPath));

    if (!email || !password) {
      errorMsg = 'credenciales';
    } else {
      let authenticated = false;

      if (hasSupabaseConfig()) {
        try {
          const supabase = createSupabaseServerClient({
            request: Astro.request,
            cookies: Astro.cookies,
          });

          const { data: signIn, error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });

          if (!error && signIn.user) {
            authenticated = true;
            try {
              await supabase
                .from('profiles')
                .upsert({ user_id: signIn.user.id, role: 'admin' }, { onConflict: 'user_id' });
            } catch {
              // Ignorar si la tabla aún no fue migrada
            }
          } else if (matchesMasterCredentials(email, password)) {
            // Si aún no existe la cuenta maestra en Supabase Auth, intentamos registrarla automáticamente
            try {
              await supabase.auth.signUp({ email, password });
              await supabase.auth.signInWithPassword({ email, password });
            } catch {
              // Continuar con cookie firmada
            }
            authenticated = true;
          }
        } catch {
          if (matchesMasterCredentials(email, password)) {
            authenticated = true;
          }
        }
      } else if (matchesMasterCredentials(email, password)) {
        authenticated = true;
      }

      if (!authenticated && matchesMasterCredentials(email, password)) {
        authenticated = true;
      }

      if (!authenticated) {
        recordFailedLogin(ip);
        rateLimit = checkLoginRateLimit(ip);
        errorMsg = rateLimit.allowed ? 'credenciales' : 'bloqueado';
      } else {
        clearLoginAttempts(ip);
        Astro.cookies.set(MASTER_SESSION_COOKIE, createMasterSessionToken(email), {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          secure: import.meta.env.PROD,
          maxAge: 60 * 60 * 12,
        });
        return Astro.redirect(formNext, 302);
      }
    }
  }
}

const minutosEspera = Math.max(1, Math.ceil(rateLimit.retryAfterSeconds / 60));

const mensajes: Record<string, string> = {
  credenciales: 'El correo o la contraseña no son correctos. Verifica tus datos e inténtalo de nuevo.',
  bloqueado: `Demasiados intentos fallidos. Por seguridad, espera ${minutosEspera} min antes de volver a intentarlo.`,
  config:
    'Falta configurar SUPABASE_URL y SUPABASE_KEY en las variables de entorno del servidor.',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Acceso administrativo · Parroquia San Chárbel</title>
    <Font cssVariable="--font-playfair" preload={[{ weight: 700, subset: 'latin' }]} />
    <Font cssVariable="--font-nunito" preload={[{ weight: 400, subset: 'latin' }]} />
  </head>
  <body class="min-h-screen bg-olive-900 text-ink">
    <main class="grid min-h-screen place-items-center px-4 py-12">
      <div class="w-full max-w-md rounded-band border border-gold-500/30 bg-ivory p-8 shadow-lift md:p-10">
        <AdminBrand size="lg" tone="dark" />

        <p class="mt-3 text-center text-small text-ink-soft">
          Ingresa con tus credenciales para administrar el calendario, banners, promociones,
          formularios, directorio comercial y archivos de la parroquia.
        </p>

        {
          resetOk && (
            <div
              class="mt-5 rounded-card border border-olive-700/30 bg-sand-soft px-4 py-3 text-small font-semibold text-ink"
              role="status"
            >
              Tu contraseña se actualizó correctamente. Ya puedes iniciar sesión.
            </div>
          )
        }

        {
          errorMsg && mensajes[errorMsg] && (
            <div
              class="mt-5 flex items-start gap-2.5 rounded-card border border-gold-300 bg-gold-100 px-4 py-3 text-small font-semibold text-gold-600"
              role="alert"
            >
              <span class="mt-0.5 shrink-0">
                <Icon name="triangle-alert" size={18} />
              </span>
              <span>{mensajes[errorMsg]}</span>
            </div>
          )
        }

        <form method="POST" class="mt-6 space-y-5" autocomplete="on">
          <input type="hidden" name="next" value={nextPath} />
          <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken ?? ''} />

          <label class="block">
            <span class="text-small font-semibold text-ink">Usuario / Correo electrónico</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="username"
              placeholder="admin@parroquiasancharbel.org"
              disabled={!rateLimit.allowed}
              class="mt-1.5 min-h-11 w-full rounded-card border border-line bg-surface px-3.5 py-2.5 text-body text-ink disabled:opacity-60"
            />
          </label>

          <div>
            <div class="flex items-center justify-between gap-2">
              <label for="login-password" class="text-small font-semibold text-ink">
                Contraseña
              </label>
              <a
                href="/admin/recuperar"
                class="text-small font-semibold text-gold-600 no-underline hover:text-olive-700 hover:underline"
              >
                ¿Olvidaste tu contraseña?
              </a>
            </div>

            <div class="relative mt-1.5">
              <input
                id="login-password"
                type="password"
                name="password"
                required
                autocomplete="current-password"
                disabled={!rateLimit.allowed}
                class="min-h-11 w-full rounded-card border border-line bg-surface py-2.5 pr-20 pl-3.5 text-body text-ink disabled:opacity-60"
              />
              <button
                type="button"
                data-toggle-pw
                class="absolute top-1/2 right-2 min-h-9 -translate-y-1/2 rounded-pill px-3 text-overline font-semibold text-gold-600 hover:bg-gold-100"
              >
                Mostrar
              </button>
            </div>
          </div>

          <button
            type="submit"
            disabled={!rateLimit.allowed}
            class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-pill bg-olive-700 px-6 py-3 text-small font-semibold text-on-dark transition-colors hover:bg-olive-600 disabled:opacity-60"
          >
            <span>Entrar al Dashboard</span>
            <Icon name="arrow-right" size={16} />
          </button>
        </form>

        <div class="mt-6 border-t border-line pt-5 text-center">
          <a
            href="/"
            class="inline-flex min-h-11 items-center gap-1.5 text-small font-semibold text-gold-600 no-underline hover:text-olive-700"
          >
            <Icon name="chevron-left" size={16} />
            <span>Volver a la página pública</span>
          </a>
        </div>
      </div>
    </main>

    <script>
      const pwInput = document.getElementById('login-password') as HTMLInputElement | null;
      const toggleBtn = document.querySelector<HTMLButtonElement>('[data-toggle-pw]');

      if (pwInput && toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const showing = pwInput.type === 'text';
          pwInput.type = showing ? 'password' : 'text';
          toggleBtn.textContent = showing ? 'Mostrar' : 'Ocultar';
        });
      }
    </script>
  </body>
</html>

---
/**
 * Vista previa de la agenda con datos de prueba.
 *
 * Existe porque hasta que el calendario de la parroquia esté conectado, /agenda
 * se ve vacía y no hay forma de revisar el diseño ni de mostrárselo al equipo.
 *
 * **Solo funciona con `npm run dev`.** En producción responde 404, así que no
 * hay riesgo de que datos inventados lleguen a la parroquia.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AgendaHero from '@/components/agenda/AgendaHero.astro';
import MonthCalendar from '@/components/agenda/MonthCalendar.astro';
import NextEvent from '@/components/agenda/NextEvent.astro';
import UpcomingList from '@/components/agenda/UpcomingList.astro';
import { buildMonthGrid } from '@/lib/agenda/month-grid';
import { agendaWindow } from '@/lib/agenda/window';
import { toParishEvents } from '@/lib/google-calendar/normalize';
import { groupByDay, upcomingEvents } from '@/lib/queries/agenda';

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const now = new Date('2026-08-08T15:00:00-05:00');

const CRUDOS = [
  {
    id: 'evt-misa',
    status: 'confirmed',
    summary: 'Misa a San Chárbel',
    description: 'Celebración mensual con bendición del aceite y veneración de la reliquia.',
    location: 'Templo parroquial',
    htmlLink: 'https://calendar.google.com/event?eid=1',
    start: { dateTime: '2026-08-12T18:00:00-05:00' },
    end: { dateTime: '2026-08-12T19:30:00-05:00' },
  },
  {
    id: 'evt-conf',
    status: 'confirmed',
    summary: 'Confesiones',
    location: 'Capilla del Santísimo',
    htmlLink: 'https://calendar.google.com/event?eid=5',
    start: { dateTime: '2026-08-12T16:00:00-05:00' },
    end: { dateTime: '2026-08-12T17:00:00-05:00' },
  },
  {
    id: 'evt-noche',
    status: 'confirmed',
    summary: 'Vigilia nocturna',
    location: 'Capilla',
    htmlLink: 'https://calendar.google.com/event?eid=4',
    start: { dateTime: '2026-08-12T22:00:00-05:00' },
    end: { dateTime: '2026-08-13T01:00:00-05:00' },
  },
  {
    id: 'evt-triduo',
    status: 'confirmed',
    summary: 'Triduo de preparación',
    description: 'Tres días de preparación para la fiesta patronal.',
    htmlLink: 'https://calendar.google.com/event?eid=3',
    // Google entrega el fin EXCLUSIVO: esto es 17, 18 y 19.
    start: { date: '2026-08-17' },
    end: { date: '2026-08-20' },
  },
  {
    id: 'evt-todo-el-dia',
    status: 'confirmed',
    summary: 'Fiesta patronal',
    description: 'Jornada completa de celebración.',
    location: 'Villa Carolina',
    htmlLink: 'https://calendar.google.com/event?eid=2',
    start: { date: '2026-08-20' },
    end: { date: '2026-08-21' },
  },
  {
    id: 'evt-borde',
    status: 'confirmed',
    summary: 'Rosario comunitario',
    location: 'Templo parroquial',
    htmlLink: 'https://calendar.google.com/event?eid=6',
    // 19:00 en Bogotá = 00:00 UTC del día siguiente. Debe caer el 31, no el 1.
    start: { dateTime: '2026-08-31T19:00:00-05:00' },
    end: { dateTime: '2026-08-31T20:00:00-05:00' },
  },
];

const eventos = toParishEvents(CRUDOS);
const ventana = agendaWindow(now);
const grid = buildMonthGrid({
  monthKey: '2026-08',
  events: eventos,
  now,
  firstMonth: ventana.firstMonth,
  lastMonth: ventana.lastMonth,
})!;
const proximos = upcomingEvents(eventos, now, 12);
const diasEnlazables = new Set(groupByDay(proximos).map((g) => g.key));
const proximoEvento = proximos[0]!;
---

<BaseLayout title="Vista previa de la agenda" description="Vista previa con datos de prueba.">
  <p class="bg-gold-600 px-4 py-2 text-center text-small font-bold text-on-dark">
    Vista previa con datos de prueba. Estos eventos no son reales.
  </p>

  <AgendaHero
    status="ok"
    fetchedAt={new Date(now.getTime() - 4 * 60 * 1000)}
    eventCount={proximos.length}
  />

  <div class="mx-auto max-w-(--container-page) px-4 py-14 md:px-6 md:py-20">
    <NextEvent event={proximoEvento} headingId="titulo-proximo" />

    <div class="mt-14 grid gap-12 md:mt-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <MonthCalendar
          grid={grid}
          linkableDays={diasEnlazables}
          headingId="titulo-calendario"
          basePath="/agenda/vista-previa"
        />
      </div>

      <div class="lg:col-span-5">
        <UpcomingList events={proximos} headingId="titulo-proximos" />
      </div>
    </div>
  </div>
</BaseLayout>
